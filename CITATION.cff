    given-names: Aleksandr
repository-code: "https://github.com/alexar76/warden"
url: "https://warden.modelmarket.dev/"
license: MIT
version: 0.22.2
date-released: 2026-10-27
keywords:
  - model-context-protocol
  - mcp-security
  - tool-poisoning
  - prompt-injection
  - supply-chain-security
references:
