{
  "name": "@aimarket/warden",
  "version": "0.22.1",
  "description": "WARDEN — MCP security firewall. Stdio wrap proxy, inspection tools and library. Vets definitions before model exposure. Zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "AICOM (alexar76)",
  "homepage": "https://warden.modelmarket.dev/",
  "mcpName": "io.github.alexar76/warden",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexar76/warden.git"
  },
  "bugs": {
    "url": "https://github.com/alexar76/warden/issues"
  },
  "bin": {
    "warden-mcp": "dist/mcp-server.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./jcs": {
      "types": "./dist/jcs.d.ts",
      "import": "./dist/jcs.js",
      "default": "./dist/jcs.js"
    },
    "./atomic-screen": {
      "types": "./dist/atomic-screen.d.ts",
      "import": "./dist/atomic-screen.js",
      "default": "./dist/atomic-screen.js"
    }
  },
  "files": [
    "dist",
    "scripts/check-quality-gate.mjs",
    "scripts/quality-public-key.pem",
    "README.md",
    "docs/scan*.md",
    "README-ru.md",
    "README-es.md",
    "README-fr.md",
    "README-zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/security-hardening*.md",
    "docs/gates*.md",
    "docs/flow-guard*.md",
    "examples/atomic-screen-server.mjs",
    "examples/answer-gate-host.mjs",
    "native/macos/Package.swift",
    "native/macos/Sources",
    "scripts/build-macos.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "mcp": "node dist/mcp-server.js",
    "build": "tsc -p tsconfig.json && node scripts/sync-flow-guard.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:redteam": "node scripts/redteam/flow-redteam.mjs --check",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test && npm run test:redteam && npm run check:ruleset && npm run check:quality",
    "check:quality": "node scripts/check-quality-gate.mjs",
    "check:ruleset": "node scripts/check-published-ruleset.mjs",
    "bench:wrap": "npm run build && node scripts/benchmark-wrap.mjs",
    "build:macos": "node scripts/build-macos.mjs",
    "test:macos": "node scripts/build-macos.mjs && node scripts/build-macos.mjs --tests && npm run build && vitest run --config vitest.macos.config.ts"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "mcp-security",
    "model-context-protocol",
    "prompt-injection",
    "tool-poisoning",
    "warden",
    "firewall",
    "security",
    "ai-agent",
    "llm",
    "aimarket",
    "aicom"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
