# WARDEN 0.26.0 for HISTOR on 82.47.146.138: the running production image (histor-histor:pre-wd-20261111 =
# sha256:da716f988d4d…, WARDEN 0.25.0) with its vendored WARDEN replaced by the release archive of 52fffde67
# (ff8e9fc959caf1ec…) and the WARDEN source of the same commit where the trusted recipe puts it. Nothing of
# HISTOR's own code changes. Recipe as for 0.23.0 (docs/evidence/warden-release-0.23.0-2026-11-04/quality).
FROM histor-histor:pre-wd-20261111
USER 0:0
RUN rm -rf /app/scanner/node_modules/@aimarket/warden /opt/warden-source/src
COPY package/ /app/scanner/node_modules/@aimarket/warden/
COPY src/ /opt/warden-source/src/
LABEL skopos.source.commit="52fffde67532419fa86582c26cff91ce648a595f" \
      aicom.histor.overlay="warden-0260-prod-20261111" \
      org.aimarket.release.candidate="warden-0.26.0" \
      org.aimarket.release.tarball-sha256="ff8e9fc959caf1ec2184592bb4cde9ea34d475ea42ce0b380c803afe97331f6b" \
      org.aimarket.release.warden-build="de9f98d627832446e0433cd112898d1106758f89f31506feeed71a7903530ec8"
USER 65532:65532
RUN node --input-type=module -e "import {readFileSync} from 'node:fs'; const p=JSON.parse(readFileSync('/app/scanner/node_modules/@aimarket/warden/package.json','utf8')); if(p.name!=='@aimarket/warden'||p.version!=='0.26.0') process.exit(1)"
