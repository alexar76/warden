# Only the scanner package changes. HISTOR's deployed application and schema stay pinned.
# The host pins this local base tag to a reviewed production image during enrollment.
FROM node:22-bookworm-slim AS test
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /warden
COPY warden/package*.json warden/tsconfig.json ./
COPY warden/src ./src
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY warden/ ./
RUN npm run build
CMD ["npm", "test"]

FROM histor:warden-remediation-base
COPY --from=test /warden/dist /app/scanner/node_modules/@aimarket/warden/dist

COPY --from=test /warden/src /opt/warden-source/src
