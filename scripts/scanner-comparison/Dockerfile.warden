# WARDEN for the 2026-10-16 comparison: the `npm pack` tarball of warden/ at the measured commit,
# on the same base as Dockerfile.competitors, run under the same flags (runsc, no network).
#   npm pack --pack-destination <ctx>   (in warden/)  →  aimarket-warden-0.16.0.tgz
#   docker build -f Dockerfile.warden -t warden-run:20261016 <ctx>
FROM node:22-alpine
LABEL warden-cmp=20261016
COPY aimarket-warden-0.16.0.tgz /tmp/
RUN npm install -g --ignore-scripts /tmp/aimarket-warden-0.16.0.tgz && rm /tmp/aimarket-warden-0.16.0.tgz && npm cache clean --force
ENV HOME=/tmp NO_COLOR=1
USER node
WORKDIR /work
